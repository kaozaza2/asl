<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ListPreference
        app:key="defaultProfile"
        app:title="@string/settings_default_profile"
        app:summary="@string/settings_default_profile_summary"
        app:iconSpaceReserved="false" />

    <ListPreference
        app:key="launchMode"
        app:title="@string/settings_launch_mode"
        app:summary="@string/settings_launch_mode_summary"
        app:iconSpaceReserved="false"
        app:entries="@array/settings_launch_mode_entries"
        app:entryValues="@array/settings_launch_mode_values" />
</PreferenceScreen>
