<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ListPreference
        app:key="theme"
        app:title="@string/settings_theme"
        app:summary="@string/settings_theme_summary"
        app:iconSpaceReserved="false"
        app:entries="@array/settings_theme_entries"
        app:entryValues="@array/settings_theme_values" />

    <SwitchPreferenceCompat
        app:key="keepScreenOn"
        app:title="@string/settings_keep_screen_on"
        app:summary="@string/settings_keep_screen_on_summary"
        app:iconSpaceReserved="false" />
</PreferenceScreen>
