<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:key="status"
        app:title="@string/settings_status"
        app:iconSpaceReserved="false" />

    <PreferenceCategory
        app:key="resources"
        app:title="@string/settings_resources"
        app:iconSpaceReserved="false">

        <EditTextPreference
            app:key="memoryMb"
            app:title="@string/settings_memory"
            app:iconSpaceReserved="false" />

        <ListPreference
            app:key="processors"
            app:title="@string/settings_processors"
            app:summary="@string/settings_processors_summary"
            app:iconSpaceReserved="false"
            app:entries="@array/settings_processors_entries"
            app:entryValues="@array/settings_processors_values" />

        <EditTextPreference
            app:key="defaultDiskSizeGb"
            app:title="@string/settings_disk_size"
            app:summary="@string/settings_disk_size_summary"
            app:iconSpaceReserved="false" />

        <EditTextPreference
            app:key="kernelCommandLine"
            app:title="@string/settings_kernel_cmdline"
            app:summary="@string/settings_kernel_cmdline_summary"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            app:key="autoStart"
            app:title="@string/settings_auto_start"
            app:summary="@string/settings_auto_start_summary"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory
        app:key="storage"
        app:title="@string/settings_android_storage"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            app:key="mountAndroidStorage"
            app:title="@string/settings_mount_storage"
            app:summary="@string/settings_mount_storage_summary"
            app:iconSpaceReserved="false" />

        <EditTextPreference
            app:key="androidStoragePath"
            app:title="@string/settings_storage_path"
            app:iconSpaceReserved="false"
            app:dependency="mountAndroidStorage" />

        <Preference
            app:key="allFiles"
            app:title="@string/settings_all_files"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <Preference
        app:key="restartNote"
        app:summary="@string/settings_restart_note"
        app:iconSpaceReserved="false"
        app:selectable="false" />

    <PreferenceCategory
        app:key="console"
        app:title="@string/settings_console"
        app:iconSpaceReserved="false" />
</PreferenceScreen>
