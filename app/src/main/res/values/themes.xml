<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The wallpaper stands in for Mica: it shows through terminals whose opacity is below 100%. -->
    <style name="Theme.Asl" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/windows_blue</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/windows_blue</item>
        <item name="android:colorBackground">@color/window_background</item>
        <item name="colorSurface">@color/window_background</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorSurfaceContainer">@color/card</item>
        <item name="colorSurfaceContainerHigh">@color/tab_active</item>
        <item name="colorSurfaceContainerHighest">@color/card_high</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/divider</item>
        <item name="colorError">@color/error</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.Asl.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.Asl.Medium</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Material3.Dialog.Alert</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
        <item name="android:windowSplashScreenBackground">@color/window_background</item>
    </style>

    <style name="ShapeAppearance.Asl.Small" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">4dp</item>
    </style>

    <style name="ShapeAppearance.Asl.Medium" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>
</resources>
